<?xml version="1.0" encoding="utf-8"?>
<!-- package is the code namespace (R, classes); android/build.sh sets the
     application id, com.togawa.bdon_immersive_home. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.bdon.immersivehome">

    <uses-feature android:name="android.software.live_wallpaper" android:required="true" />
    <uses-feature android:name="android.hardware.opengles.aep" android:required="false" />

    <!-- PreviousApp: find the pre-rename install (com.bdon.immersivehome) and
         open its uninstall prompt. -->
    <queries>
        <package android:name="com.bdon.immersivehome" />
    </queries>
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_label"
        android:hasCode="true">

        <!-- Launcher + settings entry. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The live wallpaper (home + lock screen). -->
        <service
            android:name=".BdonWallpaperService"
            android:exported="true"
            android:label="@string/app_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
